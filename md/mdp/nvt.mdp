integrator   = md
dt           = 0.002
nsteps       = 50000
nstlist      = 20
cutoff-scheme= Verlet
coulombtype  = PME
rcoulomb     = 1.0
rvdw         = 1.0
constraint_algorithm = lincs
constraints  = h-bonds
tcoupl       = V-rescale
tc-grps      = Protein non-Protein
tau_t        = 0.1 0.1
ref_t        = 300 300
pcoupl       = no
pbc          = xyz
gen_vel      = yes
gen_temp     = 300
gen_seed     = -1
nstxout-compressed = 5000
define       = -DPOSRES
