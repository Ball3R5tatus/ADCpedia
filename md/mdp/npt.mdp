integrator   = md
dt           = 0.002
nsteps       = 50000
nstlist      = 20
cutoff-scheme= Verlet
coulombtype  = PME
rcoulomb     = 1.0
rvdw         = 1.0
constraint_algorithm = lincs
constraints  = h-bonds
continuation = yes
tcoupl       = V-rescale
tc-grps      = Protein non-Protein
tau_t        = 0.1 0.1
ref_t        = 300 300
pcoupl       = C-rescale
pcoupltype   = isotropic
tau_p        = 2.0
ref_p        = 1.0
compressibility = 4.5e-5
pbc          = xyz
gen_vel      = no
nstxout-compressed = 5000
define       = -DPOSRES
refcoord-scaling = com    ; scale POSRES reference coords with the box (required for posres + pressure coupling; prevents box-rescale blow-up)
