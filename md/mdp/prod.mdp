integrator   = md
dt           = 0.002
nsteps       = 25000000
nstlist      = 20
cutoff-scheme= Verlet
coulombtype  = PME
rcoulomb     = 1.0
rvdw         = 1.0
constraint_algorithm = lincs
constraints  = h-bonds
continuation = yes
tcoupl       = V-rescale
tc-grps      = Protein non-Protein
tau_t        = 0.1 0.1
ref_t        = 300 300
pcoupl       = C-rescale
pcoupltype   = isotropic
tau_p        = 5.0
ref_p        = 1.0
compressibility = 4.5e-5
pbc          = xyz
gen_vel      = no
nstxout-compressed = 5000
compressed-x-grps  = Complex      ; store only protein+ligand (~0.3 GB vs ~7.9 GB); needs grompp -n vis_fix.ndx
nstenergy    = 5000
nstlog       = 5000
